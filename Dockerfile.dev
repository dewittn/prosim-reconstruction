# PROSIM Web Interface — Development
# Optimized for hot reload during development

FROM python:3.11-slim

WORKDIR /app

# Copy project definition and install in editable mode
COPY pyproject.toml ./
COPY prosim/ ./prosim/
COPY web/ ./web/

RUN pip install --no-cache-dir -e ".[web,dev]"

# Create data directory for SQLite database
RUN mkdir -p /app/data

# Environment variables
ENV PROSIM_DATABASE_URL=sqlite:///./data/prosim.db \
    PROSIM_SECRET_KEY=dev-secret-key \
    PROSIM_HOST=0.0.0.0 \
    PROSIM_PORT=8000 \
    PROSIM_DEBUG=true \
    PYTHONUNBUFFERED=1

EXPOSE 8000

# Run with reload for development
CMD ["uvicorn", "web.app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
